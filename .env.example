# Public site URL — used for metadata, canonical URLs, sitemap, and robots.
# In production set this to your real domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Display name + location of the test server shown in the Network Info card.
# Set these to match the region your app is actually deployed in.
NEXT_PUBLIC_SERVER_NAME=Primary Test Server
NEXT_PUBLIC_SERVER_CITY=Frankfurt
NEXT_PUBLIC_SERVER_COUNTRY=Germany

# Paths to the local offline IP geolocation databases (optional).
# Leave as-is to use the default ./data location. See data/README.md to obtain
# the free DB-IP Lite / GeoLite2 .mmdb files. If absent, network info falls back
# to IP-only and the app still runs.
GEO_CITY_DB_PATH=./data/dbip-city-lite.mmdb
GEO_ASN_DB_PATH=./data/dbip-asn-lite.mmdb
